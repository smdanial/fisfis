# Which pipeline to use by default: gemini (one-call audio->note) or whisper (STT then LLM formatting)
STT_BACKEND=gemini

# Whisper model name/path, only used when STT_BACKEND=whisper. Default: small
WHISPER_MODEL=small

# LLM: used for the note formatting (and for gemini mode's audio call)
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash
# Optional override; defaults to Gemini's OpenAI-compatible endpoint.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
